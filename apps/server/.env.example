DB_USERNAME=fif
DB_PASSWORD=fif
DB_NAME=fif
DB_PORT=5434
DATABASE_URL=postgresql://fif:fif@localhost:5434/fif?schema=public
PORT=4000
BETTER_AUTH_SECRET=fif-dev-better-auth-secret-change-me
BETTER_AUTH_URL=http://localhost:4000
ADMIN_EMAIL=admin@fikiri.cd
ADMIN_PASSWORD=changeme
UPLOAD_DIR=./data/uploads
FORCE_APPLICATIONS_OPEN=true
WEBSITE_ORIGIN=http://localhost:4200
# Console dev server origin (CORS). In production the console is served under WEBSITE_ORIGIN/admin.
ADMIN_ORIGIN=http://localhost:4300
RESEND_API_KEY=re_your_api_key
MAIL_FROM=FIF 2026 <no-reply@fikiri.cd>

# --- Optional ---------------------------------------------------------------------------------------
# Fixed login code used while RESEND_API_KEY is empty (default 123456). Temporary launch measure.
# OTP_FALLBACK_CODE=123456
# Where partner messages go for solutions imported without a contact e-mail (defaults to ADMIN_EMAIL).
# CONTACT_FALLBACK_EMAIL=contact@fikiri.co
# Console URL used in badge QR codes, if the console ever leaves WEBSITE_ORIGIN/admin.
# ADMIN_APP_URL=https://admin-festival.fikiri.co

# --- Mesure d'audience (Google Analytics) ---------------------------------------------------------
# Voir docs/analytics-google-setup.md. Sans ces valeurs, le site fonctionne sans mesure ni bandeau.
# Identifiant public envoyé au navigateur (G-…).
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Lecture des statistiques dans la console (rôle Lecteur sur la propriété).
# GA4_PROPERTY_ID=123456789
# Client OAuth + jeton obtenu une fois (étape 2 du guide).
# GA_OAUTH_CLIENT_ID=123-abc.apps.googleusercontent.com
# GA_OAUTH_CLIENT_SECRET=GOCSPX-...
# GA_OAUTH_REFRESH_TOKEN=1//...
# Variante acceptée si l'organisation autorise les clés de compte de service.
# GA_SERVICE_ACCOUNT_EMAIL=fif-analytics-lecture@projet.iam.gserviceaccount.com
# GA_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
