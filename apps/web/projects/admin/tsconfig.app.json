{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/admin",
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./../../src/*"
      ],
      "@admin/*": [
        "./src/app/*"
      ]
    },
    "rootDir": "../.."
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
