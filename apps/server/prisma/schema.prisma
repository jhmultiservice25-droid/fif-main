generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                   @id
  name                 String
  email                String
  emailVerified        Boolean
  image                String?
  role                 String                   @default("USER")
  createdAt            DateTime
  updatedAt            DateTime
  sessions             Session[]
  accounts             Account[]
  organizationProfile  OrganizationProfile?
  innovatorProfile     InnovatorProfile?
  notifications        UserNotification[]
  participant          ParticipantRegistration?
  sessionRegistrations SessionRegistration[]
  presentations        SolutionPresenter[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model Pole {
  id          String @id
  slug        String @unique
  name        String
  shortName   String
  description String
  order       Int
  jobs        Job[]
}

model Job {
  id                    String                 @id
  slug                  String                 @unique
  title                 String
  roleKind              String
  mission               String
  responsibilities      String[]
  profile               String[]
  headcount             Int
  poleId                String
  pole                  Pole                   @relation(fields: [poleId], references: [id])
  primaryApplications   CommitteeApplication[] @relation("PrimaryJob")
  secondaryApplications CommitteeApplication[] @relation("SecondaryJob")
}

model CommitteeApplication {
  id             String   @id @default(cuid())
  lastName       String
  postnom        String
  firstName      String
  sex            String
  birthDate      DateTime
  city           String
  whatsapp       String
  email          String
  primaryJobId   String
  primaryJob     Job      @relation("PrimaryJob", fields: [primaryJobId], references: [id])
  secondaryJobId String?
  secondaryJob   Job?     @relation("SecondaryJob", fields: [secondaryJobId], references: [id])
  motivation     String
  status         String   @default("RECEIVED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([primaryJobId])
}

model VolunteerApplication {
  id               String   @id @default(cuid())
  lastName         String
  postnom          String
  firstName        String
  sex              String
  birthDate        DateTime
  city             String
  whatsapp         String
  email            String
  primaryTeamId    String
  secondaryTeamId  String?
  motivation       String
  status           String   @default("RECEIVED")
  assignmentTeamId String?
  assignmentZone   String?
  assignmentLead   String?
  assignmentShift  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([primaryTeamId])
}

model StaffNotification {
  id        String    @id @default(cuid())
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
  @@map("staff_notification")
}

model OrganizationProfile {
  id                String             @id @default(cuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String             @default("")
  type              String             @default("")
  sector            String             @default("")
  city              String             @default("")
  contactName       String             @default("")
  contactTitle      String             @default("")
  phone             String             @default("")
  professionalEmail String             @default("")
  logoUrl           String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  needs             OrganizationNeed[]
}

model OrganizationNeed {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       OrganizationProfile @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status             String              @default("DRAFT")
  priorityChallenge  String              @default("")
  problemDomains     String[]
  solutionTypes      String[]
  priority           String              @default("")
  timeline           String              @default("")
  pilotWillingness   String              @default("")
  budgetBand         String              @default("")
  publicationConsent String              @default("DISCUSS")
  fikiriChallenge    String              @default("A_DISCUTER")
  payload            Json                @default("{}")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([publicationConsent])
}

model InnovatorProfile {
  id           String             @id @default(cuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName  String             @default("")
  organization String             @default("")
  city         String             @default("")
  phone        String             @default("")
  email        String             @default("")
  photoUrl     String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  projects     InnovatorProject[]
}

model InnovatorProject {
  id                     String           @id @default(cuid())
  innovatorId            String
  innovator              InnovatorProfile @relation(fields: [innovatorId], references: [id], onDelete: Cascade)
  status                 String           @default("DRAFT")
  title                  String           @default("")
  problemSolved          String           @default("")
  solution               String           @default("")
  sectors                String[]
  capabilities           String[]
  stage                  String           @default("")
  publicationConsent     String           @default("DISCUSS")
  pitchVideoPath         String?
  pitchVideoOriginalName String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([innovatorId])
  @@index([status])
  @@index([publicationConsent])
}

model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@map("user_notification")
}

model Speaker {
  id        String                  @id @default(cuid())
  sessions  ProgramSessionSpeaker[]
  name      String
  title     String                  @default("")
  bio       String                  @default("")
  photo     String?
  email     String?
  days      String[]                @default([])
  order     Int                     @default(0)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@index([order])
}

model EventPass {
  id          String    @id @default(cuid())
  token       String    @unique
  kind        String
  sourceId    String
  fullName    String
  email       String
  checkedInAt DateTime?
  emailSentAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([kind, sourceId])
}

model ParticipantRegistration {
  id                 String   @id @default(cuid())
  lastName           String
  postnom            String
  firstName          String
  city               String
  whatsapp           String
  email              String
  organization       String?
  selectedDays       String[]
  selectedActivities String[]
  userId             String?  @unique
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  source             String?
  createdAt          DateTime @default(now())

  @@index([email])
}

model HackademyApplication {
  id         String   @id @default(cuid())
  university  String
  city        String
  teamName   String
  teamLeader String
  whatsapp   String
  email      String
  memberNames String[]
  logoPath   String
  createdAt  DateTime @default(now())

  @@index([teamName])
  @@index([email])
  @@index([createdAt])
}

model Room {
  id        String           @id @default(cuid())
  name      String
  capacity  Int?
  color     String           @default("#006da4")
  order     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  sessions  ProgramSession[]

  @@map("room")
}

/// A slot in the festival programme. Named ProgramSession because Better Auth owns `Session`.
model ProgramSession {
  id              String                  @id @default(cuid())
  code            String?                 @unique
  title           String
  description     String                  @default("")
  type            String                  @default("TALK")
  startsAt        DateTime                @db.Timestamptz(3)
  endsAt          DateTime                @db.Timestamptz(3)
  roomId          String?
  room            Room?                   @relation(fields: [roomId], references: [id], onDelete: SetNull)
  visibility      String                  @default("PUBLIC")
  admission       String                  @default("OPEN")
  capacity        Int?
  waitlistEnabled Boolean                 @default(true)
  status          String                  @default("SCHEDULED")
  cancelReason    String?
  version         Int                     @default(1)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  speakers        ProgramSessionSpeaker[]
  registrations   SessionRegistration[]
  changes         SessionChange[]

  @@index([startsAt])
  @@map("program_session")
}

model ProgramSessionSpeaker {
  sessionId String
  session   ProgramSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speakerId String
  speaker   Speaker        @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@id([sessionId, speakerId])
  @@map("program_session_speaker")
}

model SessionRegistration {
  id          String         @id @default(cuid())
  sessionId   String
  session     ProgramSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String
  note        String?
  requestedAt DateTime       @default(now())
  decidedAt   DateTime?
  decidedById String?
  seenAt      DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId, status])
  @@map("session_registration")
}

model SessionChange {
  id         String         @id @default(cuid())
  sessionId  String
  session    ProgramSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  actorId    String?
  kind       String
  before     Json
  after      Json
  notifiedAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([sessionId, createdAt])
  @@index([notifiedAt])
  @@map("session_change")
}

/// Selections and identity typed in the registration modal, held until the e-mail code is verified.
model PendingInterest {
  id         String   @id @default(cuid())
  email      String   @unique
  sessionIds String[]
  identity   Json?
  source     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("pending_interest")
}

/// One of the selected solutions imported by admins (PRD-003 §7), presented at the festival by innovators.
model ShowcaseSolution {
  id           String              @id @default(cuid())
  reference    String              @unique
  name         String
  summary      String              @default("")
  sector       String              @default("")
  city         String              @default("")
  teamName     String              @default("")
  contactEmail String?
  website      String?
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  presenters   SolutionPresenter[]

  @@index([active, name])
  @@map("showcase_solution")
}

model SolutionPresenter {
  id             String           @id @default(cuid())
  solutionId     String
  solution       ShowcaseSolution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listedPublicly Boolean          @default(true)
  assignedById   String?
  createdAt      DateTime         @default(now())

  @@unique([solutionId, userId])
  @@index([userId])
  @@map("solution_presenter")
}

/// Single row (id = "default").
model ShowcaseSettings {
  id                 String    @id @default("default")
  pickerOpen         Boolean   @default(true)
  deadline           DateTime? @db.Timestamptz(3)
  maxPerInnovator    Int       @default(2)
  maxPerSolution     Int       @default(3)
  demoShowSessionIds String[]
  reminderSentAt     DateTime?
  updatedAt          DateTime  @updatedAt

  @@map("showcase_settings")
}

/// Message from a partner to a solution or project owner, relayed by e-mail (PRD-003 §6.3).
model ContactMessage {
  id                 String    @id @default(cuid())
  targetType         String
  targetId           String
  targetName         String
  recipientEmail     String
  senderName         String
  senderEmail        String
  senderOrganization String    @default("")
  senderType         String
  message            String
  deliveredAt        DateTime?
  createdAt          DateTime  @default(now())

  @@index([targetType, targetId])
  @@index([senderEmail, createdAt])
  @@map("contact_message")
}

/// Festival identity and dates, editable by admins (single row, id = "default").
model FestivalSettings {
  id                  String    @id @default("default")
  name                String    @default("FIKIRI Innovation Festival")
  shortName           String    @default("FIF 2026")
  city                String    @default("Kinshasa")
  country             String    @default("RDC")
  /// Ordered days: [{ "date": "2026-12-02", "label": "Jour 1", "theme": "…" }]
  days                Json
  badgeDeadline       DateTime? @db.Timestamptz(3)
  applicationsOpenAt  DateTime? @db.Timestamptz(3)
  applicationsCloseAt DateTime? @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt

  @@map("festival_settings")
}
