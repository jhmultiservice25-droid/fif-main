{
  "name": "fif",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:server": "turbo run dev --filter=server",
    "dev:web": "turbo run dev --filter=web",
    "build": "turbo run build",
    "build:server": "turbo run build --filter=server",
    "build:web": "turbo run build --filter=web",
    "lint": "turbo run lint",
    "lint:server": "turbo run lint --filter=server",
    "lint:web": "turbo run lint --filter=web",
    "typecheck": "turbo run typecheck",
    "typecheck:server": "turbo run typecheck --filter=server",
    "typecheck:web": "turbo run typecheck --filter=web",
    "docker:dev": "docker compose --env-file apps/server/.env -f compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f compose.dev.yml down",
    "docker:prod": "docker compose --env-file apps/server/.env -f compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose -f compose.prod.yml down",
    "prepare": "husky",
    "dev:admin": "turbo run dev:admin --filter=web"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "turbo": "^2.5.0"
  }
}
