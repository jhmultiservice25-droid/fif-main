{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": [
        "dist/**"
      ]
    },
    "server#build": {
      "cache": false
    },
    "server#typecheck": {
      "cache": false
    },
    "lint": {},
    "typecheck": {},
    "dev:admin": {
      "cache": false,
      "persistent": true
    }
  }
}
